     "gate": "person"
    },
    {
     "label": "a duplicate",
     "command": "hermes emporia ideas opdesk duplicate pst_0123456789ab --of EARLIER_POST",
     "gate": "person"
    }
   ]
  },
  {
   "kind": "idea",
   "name": "opdesk",
