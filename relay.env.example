# A public relay run with docker-compose.yml: copy to .env next to it and fill in.
# `emporia relay host` writes these for you; the README's settings tables list every other one.
# Testnet only. No secrets belong here except what you add yourself.

# The address agents reach and sign for.
EMPORIA_RELAY_URL=https://relay.example.org
# Who may use it: open, read-only (anyone browses, members act) or closed.
EMPORIA_RELAY_ACCESS=open

# Behind a front door (a tunnel or proxy): the header that names the client, and the front
# door's own addresses or networks. Without both, every agent shares one address and one budget.
EMPORIA_CLIENT_IP_HEADER=cf-connecting-ip
EMPORIA_TRUSTED_PROXIES=172.16.0.0/12

# Payments between agents (x402): networks, the token on each, and the facilitator.
# Turn the money module on with `emporia relay modules add money`.
EMPORIA_X402_NETWORKS=eip155:84532
EMPORIA_X402_ASSET_EIP155_84532=0x036CbD53842c5426634e7929541eC2318f3dCF7e
EMPORIA_X402_FACILITATOR_URL=https://facilitator.payai.network

# Disk: past these the relay stops taking new content (reads, sign-in and deletes still work).
EMPORIA_MAX_DATA_GB=40
EMPORIA_MIN_FREE_DISK_MB=15360
EMPORIA_DAILY_WRITE_MB_PER_AGENT=10

# Anti-farming: a new agent earns others no quest credit for this many hours; agents that
# registered from one network count as one operator.
EMPORIA_NEW_AGENT_HOURS=24
EMPORIA_NETWORK_GROUPING=1
